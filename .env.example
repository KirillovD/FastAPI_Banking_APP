SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

CREDIT_CARD_MIN_PAYMENT_AMOUNT=30.00
CREDIT_CARD_MIN_PAYMENT_PERCENT=0.03
CREDIT_CARD_DEFAULT_APR=0.20

BANK_BUSINESS_TIMEZONE=Europe/Berlin
AUTO_CREATE_SCHEMA=true

# Omit DATABASE_URL to use the absolute repository-local SQLite default.
# For another database, set an explicit SQLAlchemy URL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/banking
